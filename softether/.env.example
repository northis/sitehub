# SoftEther VPN secrets.
#
# install-vpn.sh creates .env with mode 600; .env is gitignored.
# This example contains placeholders only - never put real passwords here.

# Server administrator password (vpncmd /SERVER authentication).
VPN_SERVER_PASSWORD=changeme

# Password of the REMOTE hub.
VPN_HUB_PASSWORD=changeme

# Default password for VPN site users (site1, ...).
VPN_USER_PASSWORD=changeme
