# SiteHub environment configuration.
# Copy to .env, fill in real values, and protect it:
#   cp .env.example .env && chmod 600 .env

# Base domain. Sites live on subdomains: site1.<DOMAIN>, site2.<DOMAIN>, ...
# A wildcard certificate *.<DOMAIN> (plus SAN <DOMAIN>) is issued automatically.
DOMAIN=foodomain.com

# Email for the Let's Encrypt account (expiry and security notices).
LE_EMAIL=user@example.com

# Cloudflare API token scoped to Zone -> DNS -> Edit for this zone only.
# Create it at: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=

# Let's Encrypt ACME directory.
# Production (default):
LE_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Staging (use while experimenting; issues untrusted certificates,
# does not consume production rate limits):
# LE_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Timezone for container logs.
TZ=UTC

# Origin-side validation of Cloudflare Access JWTs (see the README section
# "Cloudflare Access (Zero Trust)"). When true, cf-access-verify@file is
# added to the websecure entrypoint middlewares, so every site requires a
# valid Access JWT and public Bypass apps get 401. Requires the verifier
# container: sudo ./scripts/install-access-verify.sh
CF_ACCESS_VERIFY_GLOBAL=false
