# SiteHub environment configuration.
# Copy to .env, fill in real values, and protect it:
#   cp .env.example .env && chmod 600 .env

# Base domain. Sites live on subdomains: site1.<DOMAIN>, site2.<DOMAIN>, ...
# A wildcard certificate *.<DOMAIN> (plus SAN <DOMAIN>) is issued automatically.
DOMAIN=foodomain.com

# Email for the Let's Encrypt account (expiry and security notices).
LE_EMAIL=user@example.com

# Cloudflare API token scoped to Zone -> DNS -> Edit for this zone only.
# Create it at: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=

# Let's Encrypt ACME directory.
# Production (default):
LE_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Staging (use while experimenting; issues untrusted certificates,
# does not consume production rate limits):
# LE_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Timezone for container logs.
TZ=UTC

# Origin-side validation of Cloudflare Access JWTs (see the README section
# "Cloudflare Access (Zero Trust)"). When true, cf-access-verify@file is
# added to the websecure entrypoint middlewares, so every site requires a
# valid Access JWT and public Bypass apps get 401. Requires the verifier
# container: sudo ./scripts/install-access-verify.sh
CF_ACCESS_VERIFY_GLOBAL=false

# Backup pipeline (backup_all.ps1 on the Windows host). See "Бэкапы сайтов" in the README.
# Share the archives are copied to; the run does nothing at all while it is unreachable.
SITEHUB_BACKUP_DEST=\\10.77.77.11\backup
# Interpreter that folds the local increments into one archive after a successful upload.
SITEHUB_BACKUP_PYTHON=C:\Python\python.exe
#
# One line per project: SITEHUB_BACKUP_<folder on the share>=<repository> | <backups> |
# <state file> | <command> [| --since]
# The order of the lines is the order the projects run in. The optional fifth field marks a
# tool whose first backup needs a start date; the script fills it in from the newest archive
# it finds locally or on the share.
SITEHUB_BACKUP_duosave=C:\0GitHub\duosave | data\backups\incremental | backup-state.json | docker compose exec duosave python -m duosave backup | --since
SITEHUB_BACKUP_pinsave=C:\0GitHub\PinSaver | backups | backup_state.json | docker compose exec pinsaver python ./src/backup.py
SITEHUB_BACKUP_memsave=C:\0GitHub\memsave | data\backups | backup_state.json | docker compose exec memsave python -m memsave backup
SITEHUB_BACKUP_soundsave=C:\0GitHub\soundsave | backup | state.json | soundsave backup | --since
